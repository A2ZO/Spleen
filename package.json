{
  "name": "spleen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "e2e:quiet": "node scripts/e2e-quiet.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . --log-level warn && turbo run lint typecheck test --output-logs=errors-only",
    "db:generate": "pnpm --filter @spleen/db generate",
    "db:migrate": "pnpm --filter @spleen/db migrate",
    "db:seed": "pnpm --filter @spleen/db seed",
    "db:reset": "pnpm --filter @spleen/db reset",
    "admin:grant": "pnpm --filter @spleen/db admin grant",
    "admin:revoke": "pnpm --filter @spleen/db admin revoke",
    "db:seed:catalog": "pnpm --filter @spleen/api seed:catalog",
    "catalog:refresh": "pnpm --filter @spleen/api refresh:catalog",
    "retention": "pnpm --filter @spleen/api retention"
  },
  "devDependencies": {
    "@spleen/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
