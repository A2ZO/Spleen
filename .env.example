# Spleen — environment variables.
# Copy to apps/web/.env.local and fill in. Never commit real values.
# Milestone 1 (static mockup) needs NONE of these: the site runs with fixtures.

# --- Database ----------------------------------------------------------------
# Optional for now: when unset, a local PGlite database is used (.data/pglite).
# Later: Neon Postgres, EU region. Neon console > project > Connection details.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- Auth: Better Auth (milestone 3) ----------------------------------------
# Random 32+ char secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of the site (http://localhost:3000 in dev).
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails (milestone 3) ---------------------------------------------------
# Transactional email provider API key (free tier), used for magic links.
EMAIL_API_KEY=
EMAIL_FROM="Spleen <bonjour@example.com>"

# --- File storage: Cloudflare R2, S3 API (milestone 3) ----------------------
# Cloudflare dashboard > R2 > Manage API tokens. Bucket in the EU jurisdiction.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- MusicBrainz catalog (milestone 4) --------------------------------------
# Mandatory User-Agent with a contact, see musicbrainz.org/doc/MusicBrainz_API.
MUSICBRAINZ_USER_AGENT="Spleen/0.1 ( contact@example.com )"
