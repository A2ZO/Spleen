# Spleen — environment variables.
# Copy this file to `.env` at the REPOSITORY ROOT (the only secrets file of the monorepo:
# the web app, drizzle-kit, the db scripts and the tests all read it). Never commit real values.
# In production, set the same variables in the hosting provider's settings instead.

# --- Database: Neon Postgres, EU region ------------------------------------
# Both optional locally: without DATABASE_URL, a local PGlite database is used (.data/pglite).
# Neon branches: `dev` for local development (these values), `main` for production later
# (its URLs go into the hosting provider's settings, not in this file).
# Neon console > Connect > choose the branch, copy both connection strings and uncomment.
# Pooled connection ("Connection pooling" on, host contains `-pooler`): used by the app.
# DATABASE_URL=postgresql://spleen_owner:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct connection (pooling off): used by migrations and the seed (`pnpm db:migrate|db:seed`).
# DATABASE_URL_UNPOOLED=postgresql://spleen_owner:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Not a secret: host (or endpoint id `ep-…`) of the Neon branch named `production` (the
# project's default branch, which serves the live site), so the e2e
# cleanup, which deletes test accounts, refuses to run there. While it is empty, the cleanup
# refuses every Neon database. Neon console > branch `production` > Connect: copy the host only
# (pooled or direct, both are recognised). The variable keeps its historical name.
# NEON_MAIN_HOST=ep-other-654321.eu-central-1.aws.neon.tech

# --- Auth: Better Auth -------------------------------------------------------
# REQUIRED NOW. Random secret of 32+ characters (signs sessions), e.g. `openssl rand -base64 32`.
# Use a different value in production.
BETTER_AUTH_SECRET=
# REQUIRED NOW. Public URL of the site: http://localhost:3000 in dev, https://… in production.
BETTER_AUTH_URL=http://localhost:3000
# LATER (optional): the "Continue with Google" button stays hidden while these are empty.
# Google Cloud console > APIs & Services > Credentials > Create credentials > OAuth client ID
# (type "Web application"). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Emails: Brevo -------------------------------------------------------------
# LATER, REQUIRED IN PRODUCTION. Without them, development prints magic links in the
# terminal and keeps a copy in .data/outbox/.
# Brevo > SMTP & API > API keys > Generate a new API key (v3).
BREVO_API_KEY=
# Sender verified in Brevo (Senders, domains & dedicated IPs), e.g. a domain you own.
EMAIL_FROM="Spleen <bonjour@example.com>"

# --- File storage: Cloudflare R2, S3 API ---------------------------------------
# LATER, REQUIRED IN PRODUCTION. Without them, development stores avatars in .data/uploads/.
# Cloudflare dashboard > R2 > Create bucket (jurisdiction: European Union).
# Endpoint: https://<account-id>.eu.r2.cloudflarestorage.com (shown in the bucket settings).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# R2 > Manage API tokens > Create API token (Object Read & Write, this bucket only).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL serving the bucket: bucket > Settings > Public access (r2.dev subdomain for
# testing, a custom domain such as https://files.example.com for production). No trailing slash.
S3_PUBLIC_URL=

# --- MusicBrainz catalog (milestone 4) --------------------------------------
# Mandatory User-Agent with a contact, see musicbrainz.org/doc/MusicBrainz_API.
MUSICBRAINZ_USER_AGENT="Spleen/0.1 ( contact@example.com )"
